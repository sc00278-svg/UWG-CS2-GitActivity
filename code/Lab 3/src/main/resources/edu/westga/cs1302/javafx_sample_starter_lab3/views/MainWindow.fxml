<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="534.0" prefWidth="557.0" spacing="20.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.javafx_sample_starter_lab3.views.MainWindow">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Name" />
      <TextField fx:id="name" promptText=" add the name of the item" />
      <Label text="Amount" />
      <TextField fx:id="amount" prefHeight="26.0" prefWidth="163.0" promptText="add the price of item" />
      <Button mnemonicParsing="false" onAction="#addItem" text="Add item to Bill" />
      <TextArea fx:id="output" editable="false" prefHeight="246.0" prefWidth="518.0" />
   </children>
</VBox>
